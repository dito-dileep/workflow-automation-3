<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_LoanOrigination" targetNamespace="https://example.edu/bpmn/loan-origination">
  <bpmn:error id="Error_Bureau" name="Credit bureau unavailable" errorCode="BUREAU_UNAVAILABLE" />
  <bpmn:error id="Error_Disbursement" name="Disbursement failed" errorCode="PAYMENT_FAILED" />
  <bpmn:escalation id="Escalation_Fraud" name="Fraud / AML review" escalationCode="FRAUD_REVIEW" />
  <bpmn:message id="Message_Withdrawal" name="Applicant withdrawal" />
  <bpmn:process id="Loan_Origination_Approval" name="Loan Origination &#38; Approval System" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Loan">
      <bpmn:lane id="Lane_Applicant" name="Applicant">
        <bpmn:flowNodeRef>Start_Application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CorrectDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AcceptOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ESign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Officer" name="Loan Officer">
        <bpmn:flowNodeRef>Task_ManualCredit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Core Banking System">
        <bpmn:flowNodeRef>Task_CheckDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KYC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Bureau</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Income</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Disburse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateAccount</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Credit" name="Underwriter / Credit Committee">
        <bpmn:flowNodeRef>Task_Underwrite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CounterOffer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Compliance" name="Fraud &#38; Compliance">
        <bpmn:flowNodeRef>Sub_FraudReview</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Operations" name="Operations / Disbursement">
        <bpmn:flowNodeRef>Task_HoldFunds</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Application" name="Application received">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Submit" name="Submit application &#38; documents">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="Task_CheckDocs" name="Check completeness">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Docs" name="Documents complete?" default="F5">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CorrectDocs" name="Correct / upload documents">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_DocsTimeout" name="7 days" attachedToRef="Task_CorrectDocs">
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_Lapsed" name="Application lapsed">
      <bpmn:incoming>F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="Gateway_Split" name="Run checks in parallel">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_KYC" name="Verify KYC">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Bureau" name="Retrieve credit score">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_BureauError" name="API error" attachedToRef="Task_Bureau">
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_Bureau" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Task_ManualCredit" name="Manual credit check (after 3 retries)">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Income" name="Verify income &#38; employment">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_Join" name="Checks complete">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:businessRuleTask id="Task_Risk" name="Eligibility &#38; risk scoring">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Risk" name="Decision route?">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
      <bpmn:outgoing>F19</bpmn:outgoing>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Underwrite" name="Underwriter / committee review">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CounterOffer" name="Issue reduced / secured counter-offer">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Reject" name="Notify rejection with reason">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Rejected" name="Application rejected">
      <bpmn:incoming>F23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_GenerateOffer" name="Generate &#38; send loan offer">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="Task_AcceptOffer" name="Await applicant acceptance">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Boundary_OfferExpiry" name="15 days" attachedToRef="Task_AcceptOffer">
      <bpmn:outgoing>F26</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_Expired" name="Offer expired">
      <bpmn:incoming>F26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_ESign" name="E-sign loan agreement">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Signature" name="Signature valid?" default="F29">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F28</bpmn:outgoing>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Disburse" name="Disburse to verified account">
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:outgoing>F30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_DisbursementError" name="Payment error" attachedToRef="Task_Disburse">
      <bpmn:outgoing>F31</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_Disbursement" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Task_HoldFunds" name="Hold funds &#38; contact applicant">
      <bpmn:incoming>F31</bpmn:incoming>
      <bpmn:outgoing>F32</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Held" name="Funds held for repair">
      <bpmn:incoming>F32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_CreateAccount" name="Create loan account &#38; notify">
      <bpmn:incoming>F30</bpmn:incoming>
      <bpmn:outgoing>F33</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Disbursed" name="Loan disbursed">
      <bpmn:incoming>F33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="Sub_FraudReview" name="Withdrawal: release holds &#38; compensate fees">
      <bpmn:incoming>F34</bpmn:incoming>
      <bpmn:outgoing>F35</bpmn:outgoing>
      <bpmn:startEvent id="Fraud_Start" />
      <bpmn:userTask id="Fraud_Investigate" name="Release holds and reverse eligible charges" />
      <bpmn:endEvent id="Fraud_End" name="Compensation complete" />
      <bpmn:sequenceFlow id="Fraud_F1" sourceRef="Fraud_Start" targetRef="Fraud_Investigate" />
      <bpmn:sequenceFlow id="Fraud_F2" sourceRef="Fraud_Investigate" targetRef="Fraud_End" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_Withdrawn" name="Application withdrawn">
      <bpmn:incoming>F35</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Boundary_Withdrawal" name="Applicant withdraws" attachedToRef="Task_AcceptOffer">
      <bpmn:outgoing>F34</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Withdrawal" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Application" targetRef="Task_Submit" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Submit" targetRef="Task_CheckDocs" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_CheckDocs" targetRef="Gateway_Docs" />
    <bpmn:sequenceFlow id="F4" name="yes" sourceRef="Gateway_Docs" targetRef="Gateway_Split" />
    <bpmn:sequenceFlow id="F5" name="no" sourceRef="Gateway_Docs" targetRef="Task_CorrectDocs" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_CorrectDocs" targetRef="Task_CheckDocs" />
    <bpmn:sequenceFlow id="F7" sourceRef="Boundary_DocsTimeout" targetRef="End_Lapsed" />
    <bpmn:sequenceFlow id="F8" sourceRef="Gateway_Split" targetRef="Task_KYC" />
    <bpmn:sequenceFlow id="F9" sourceRef="Gateway_Split" targetRef="Task_Bureau" />
    <bpmn:sequenceFlow id="F10" sourceRef="Gateway_Split" targetRef="Task_Income" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_KYC" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Bureau" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="F13" sourceRef="Boundary_BureauError" targetRef="Task_ManualCredit" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_ManualCredit" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Income" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="F16" sourceRef="Gateway_Join" targetRef="Task_Risk" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_Risk" targetRef="Gateway_Risk" />
    <bpmn:sequenceFlow id="F18" name="manual / high value" sourceRef="Gateway_Risk" targetRef="Task_Underwrite" />
    <bpmn:sequenceFlow id="F19" name="counter-offer" sourceRef="Gateway_Risk" targetRef="Task_CounterOffer" />
    <bpmn:sequenceFlow id="F20" name="reject" sourceRef="Gateway_Risk" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="F21" name="approved" sourceRef="Task_Underwrite" targetRef="Task_GenerateOffer" />
    <bpmn:sequenceFlow id="F22" sourceRef="Task_CounterOffer" targetRef="Task_GenerateOffer" />
    <bpmn:sequenceFlow id="F23" sourceRef="Task_Reject" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="F24" sourceRef="Task_GenerateOffer" targetRef="Task_AcceptOffer" />
    <bpmn:sequenceFlow id="F25" sourceRef="Task_AcceptOffer" targetRef="Task_ESign" />
    <bpmn:sequenceFlow id="F26" sourceRef="Boundary_OfferExpiry" targetRef="End_Expired" />
    <bpmn:sequenceFlow id="F27" sourceRef="Task_ESign" targetRef="Gateway_Signature" />
    <bpmn:sequenceFlow id="F28" name="yes" sourceRef="Gateway_Signature" targetRef="Task_Disburse" />
    <bpmn:sequenceFlow id="F29" name="resend ≤ 2" sourceRef="Gateway_Signature" targetRef="Task_ESign" />
    <bpmn:sequenceFlow id="F30" sourceRef="Task_Disburse" targetRef="Task_CreateAccount" />
    <bpmn:sequenceFlow id="F31" sourceRef="Boundary_DisbursementError" targetRef="Task_HoldFunds" />
    <bpmn:sequenceFlow id="F32" sourceRef="Task_HoldFunds" targetRef="End_Held" />
    <bpmn:sequenceFlow id="F33" sourceRef="Task_CreateAccount" targetRef="End_Disbursed" />
    <bpmn:sequenceFlow id="F34" sourceRef="Boundary_Withdrawal" targetRef="Sub_FraudReview" />
    <bpmn:sequenceFlow id="F35" sourceRef="Sub_FraudReview" targetRef="End_Withdrawn" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Loan_Origination_Approval">
    <bpmndi:BPMNPlane id="BPMNPlane_Loan_Origination_Approval" bpmnElement="Loan_Origination_Approval">
      <bpmndi:BPMNShape id="Start_Application_di" bpmnElement="Start_Application">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Submit_di" bpmnElement="Task_Submit">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckDocs_di" bpmnElement="Task_CheckDocs">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Docs_di" bpmnElement="Gateway_Docs" isMarkerVisible="true">
        <dc:Bounds x="500" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Split_di" bpmnElement="Gateway_Split">
        <dc:Bounds x="650" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_KYC_di" bpmnElement="Task_KYC">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Join_di" bpmnElement="Gateway_Join">
        <dc:Bounds x="1100" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Risk_di" bpmnElement="Task_Risk">
        <dc:Bounds x="1225" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Risk_di" bpmnElement="Gateway_Risk" isMarkerVisible="true">
        <dc:Bounds x="1400" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Underwrite_di" bpmnElement="Task_Underwrite">
        <dc:Bounds x="1525" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GenerateOffer_di" bpmnElement="Task_GenerateOffer">
        <dc:Bounds x="1675" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AcceptOffer_di" bpmnElement="Task_AcceptOffer">
        <dc:Bounds x="1825" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_OfferExpiry_di" bpmnElement="Boundary_OfferExpiry">
        <dc:Bounds x="1840.3333333333333" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_Withdrawal_di" bpmnElement="Boundary_Withdrawal">
        <dc:Bounds x="1873.6666666666667" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ESign_di" bpmnElement="Task_ESign">
        <dc:Bounds x="1975" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Signature_di" bpmnElement="Gateway_Signature" isMarkerVisible="true">
        <dc:Bounds x="2150" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Disburse_di" bpmnElement="Task_Disburse">
        <dc:Bounds x="2275" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_DisbursementError_di" bpmnElement="Boundary_DisbursementError">
        <dc:Bounds x="2307" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateAccount_di" bpmnElement="Task_CreateAccount">
        <dc:Bounds x="2425" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Disbursed_di" bpmnElement="End_Disbursed">
        <dc:Bounds x="2607" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_FraudReview_di" bpmnElement="Sub_FraudReview">
        <dc:Bounds x="1975" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Withdrawn_di" bpmnElement="End_Withdrawn">
        <dc:Bounds x="2157" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_HoldFunds_di" bpmnElement="Task_HoldFunds">
        <dc:Bounds x="2425" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Held_di" bpmnElement="End_Held">
        <dc:Bounds x="2607" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CorrectDocs_di" bpmnElement="Task_CorrectDocs">
        <dc:Bounds x="625" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_DocsTimeout_di" bpmnElement="Boundary_DocsTimeout">
        <dc:Bounds x="657" y="372" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Bureau_di" bpmnElement="Task_Bureau">
        <dc:Bounds x="775" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_BureauError_di" bpmnElement="Boundary_BureauError">
        <dc:Bounds x="807" y="372" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CounterOffer_di" bpmnElement="Task_CounterOffer">
        <dc:Bounds x="1525" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Expired_di" bpmnElement="End_Expired">
        <dc:Bounds x="2007" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Lapsed_di" bpmnElement="End_Lapsed">
        <dc:Bounds x="807" y="472" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ManualCredit_di" bpmnElement="Task_ManualCredit">
        <dc:Bounds x="925" y="450" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reject_di" bpmnElement="Task_Reject">
        <dc:Bounds x="1525" y="450" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rejected_di" bpmnElement="End_Rejected">
        <dc:Bounds x="1707" y="472" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Income_di" bpmnElement="Task_Income">
        <dc:Bounds x="775" y="590" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="500" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4">
        <di:waypoint x="550" y="70" />
        <di:waypoint x="650" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5">
