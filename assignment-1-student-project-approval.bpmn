<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ProjectApproval" targetNamespace="https://example.edu/bpmn/project-approval">
  <bpmn:error id="Error_Notification" name="Notification service failure" errorCode="NOTIFY_FAILED" />
  <bpmn:message id="Message_Withdrawal" name="Team or guide withdrawal" />
  <bpmn:process id="Student_Project_Approval" name="Student Project Approval &#38; Allocation System" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Project">
      <bpmn:lane id="Lane_Team" name="Student / Team">
        <bpmn:flowNodeRef>Start_Proposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitProposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviseProposal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Project Management System">
        <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DuplicateCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Allocate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Coordinator" name="Project Coordinator">
        <bpmn:flowNodeRef>Task_Screen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManualAllocation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Committee" name="Review Committee / HoD">
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Guide" name="Faculty Guide">
        <bpmn:flowNodeRef>Task_GuideAccept</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Proposal" name="Team decides to submit">
      <bpmn:outgoing>P1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_SubmitProposal" name="Submit project proposal">
      <bpmn:incoming>P1</bpmn:incoming>
      <bpmn:outgoing>P2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_Deadline" name="Deadline reached" attachedToRef="Task_SubmitProposal">
      <bpmn:outgoing>P3</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Task_LateRequest" name="Review late-submission request">
      <bpmn:incoming>P3</bpmn:incoming>
      <bpmn:outgoing>P4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Late" name="Late request approved?">
      <bpmn:incoming>P4</bpmn:incoming>
      <bpmn:outgoing>P5</bpmn:outgoing>
      <bpmn:outgoing>P6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_LateClosed" name="Submission closed">
      <bpmn:incoming>P6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="Task_Validate" name="Validate form &#38; team rules">
      <bpmn:incoming>P2</bpmn:incoming>
      <bpmn:incoming>P5</bpmn:incoming>
      <bpmn:incoming>P9</bpmn:incoming>
      <bpmn:outgoing>P7</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Valid" name="Valid proposal?">
      <bpmn:incoming>P7</bpmn:incoming>
      <bpmn:outgoing>P8</bpmn:outgoing>
      <bpmn:outgoing>P10</bpmn:outgoing>
      <bpmn:outgoing>P11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ReviseProposal" name="Correct proposal (max 2)">
      <bpmn:incoming>P10</bpmn:incoming>
      <bpmn:outgoing>P9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Invalid" name="Invalid team / proposal">
      <bpmn:incoming>P8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Screen" name="Coordinator screens proposal">
      <bpmn:incoming>P11</bpmn:incoming>
      <bpmn:outgoing>P12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_DuplicateCheck" name="Run duplicate-topic check">
      <bpmn:incoming>P12</bpmn:incoming>
      <bpmn:outgoing>P13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Duplicate" name="Similarity acceptable?">
      <bpmn:incoming>P13</bpmn:incoming>
      <bpmn:outgoing>P14</bpmn:outgoing>
      <bpmn:outgoing>P15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_NotifyDuplicate" name="Request new topic / record rejection">
      <bpmn:incoming>P15</bpmn:incoming>
      <bpmn:outgoing>P16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_DuplicateReject" name="Topic rejected">
      <bpmn:incoming>P16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Review" name="Committee evaluates proposal">
      <bpmn:incoming>P14</bpmn:incoming>
      <bpmn:outgoing>P17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_ReviewSLA" name="SLA reminder" cancelActivity="false" attachedToRef="Task_Review">
      <bpmn:outgoing>P18</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_RemindHoD" name="Remind committee / escalate HoD">
      <bpmn:incoming>P18</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Committee" name="Committee decision?">
      <bpmn:incoming>P17</bpmn:incoming>
      <bpmn:outgoing>P19</bpmn:outgoing>
      <bpmn:outgoing>P20</bpmn:outgoing>
      <bpmn:outgoing>P21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Reject" name="Send rejection reasons">
      <bpmn:incoming>P21</bpmn:incoming>
      <bpmn:outgoing>P22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Rejected" name="Proposal rejected">
      <bpmn:incoming>P22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="Task_FindGuide" name="Match guide availability &#38; workload">
      <bpmn:incoming>P19</bpmn:incoming>
      <bpmn:outgoing>P23</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_GuideAvailable" name="Guide available?">
      <bpmn:incoming>P23</bpmn:incoming>
      <bpmn:outgoing>P24</bpmn:outgoing>
      <bpmn:outgoing>P25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ManualAllocation" name="Manual / co-guide allocation">
      <bpmn:incoming>P25</bpmn:incoming>
      <bpmn:outgoing>P26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Allocate" name="Allocate guide &#38; send request">
      <bpmn:incoming>P24</bpmn:incoming>
      <bpmn:incoming>P26</bpmn:incoming>
      <bpmn:outgoing>P27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_GuideAccept" name="Guide accepts allocation">
      <bpmn:incoming>P27</bpmn:incoming>
      <bpmn:outgoing>P28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_GuideTimeout" name="No response" attachedToRef="Task_GuideAccept">
      <bpmn:outgoing>P29</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_ExcludeGuide" name="Exclude guide &#38; rerun match">
      <bpmn:incoming>P29</bpmn:incoming>
      <bpmn:outgoing>P30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Notify" name="Record allocation &#38; notify team">
      <bpmn:incoming>P28</bpmn:incoming>
      <bpmn:outgoing>P31</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_NotifyError" name="Notification error" attachedToRef="Task_Notify">
      <bpmn:outgoing>P32</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_Notification" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Task_ManualNotify" name="Retry / manually notify">
      <bpmn:incoming>P32</bpmn:incoming>
      <bpmn:outgoing>P33</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Allocated" name="Project allocated">
      <bpmn:incoming>P31</bpmn:incoming>
      <bpmn:incoming>P33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P1" sourceRef="Start_Proposal" targetRef="Task_SubmitProposal" />
    <bpmn:sequenceFlow id="P2" sourceRef="Task_SubmitProposal" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="P3" sourceRef="Boundary_Deadline" targetRef="Task_LateRequest" />
    <bpmn:sequenceFlow id="P4" sourceRef="Task_LateRequest" targetRef="Gateway_Late" />
    <bpmn:sequenceFlow id="P5" name="approved" sourceRef="Gateway_Late" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="P6" name="declined" sourceRef="Gateway_Late" targetRef="End_LateClosed" />
    <bpmn:sequenceFlow id="P7" sourceRef="Task_Validate" targetRef="Gateway_Valid" />
    <bpmn:sequenceFlow id="P8" name="team rule fail" sourceRef="Gateway_Valid" targetRef="End_Invalid" />
    <bpmn:sequenceFlow id="P9" sourceRef="Task_ReviseProposal" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="P10" name="correctable" sourceRef="Gateway_Valid" targetRef="Task_ReviseProposal" />
    <bpmn:sequenceFlow id="P11" name="valid" sourceRef="Gateway_Valid" targetRef="Task_Screen" />
    <bpmn:sequenceFlow id="P12" sourceRef="Task_Screen" targetRef="Task_DuplicateCheck" />
    <bpmn:sequenceFlow id="P13" sourceRef="Task_DuplicateCheck" targetRef="Gateway_Duplicate" />
    <bpmn:sequenceFlow id="P14" name="yes" sourceRef="Gateway_Duplicate" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="P15" name="no" sourceRef="Gateway_Duplicate" targetRef="Task_NotifyDuplicate" />
    <bpmn:sequenceFlow id="P16" sourceRef="Task_NotifyDuplicate" targetRef="End_DuplicateReject" />
    <bpmn:sequenceFlow id="P17" sourceRef="Task_Review" targetRef="Gateway_Committee" />
    <bpmn:sequenceFlow id="P18" sourceRef="Boundary_ReviewSLA" targetRef="Task_RemindHoD" />
    <bpmn:sequenceFlow id="P19" name="approve" sourceRef="Gateway_Committee" targetRef="Task_FindGuide" />
    <bpmn:sequenceFlow id="P20" name="revise" sourceRef="Gateway_Committee" targetRef="Task_ReviseProposal" />
    <bpmn:sequenceFlow id="P21" name="reject" sourceRef="Gateway_Committee" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="P22" sourceRef="Task_Reject" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="P23" sourceRef="Task_FindGuide" targetRef="Gateway_GuideAvailable" />
    <bpmn:sequenceFlow id="P24" name="yes" sourceRef="Gateway_GuideAvailable" targetRef="Task_Allocate" />
    <bpmn:sequenceFlow id="P25" name="no" sourceRef="Gateway_GuideAvailable" targetRef="Task_ManualAllocation" />
    <bpmn:sequenceFlow id="P26" sourceRef="Task_ManualAllocation" targetRef="Task_Allocate" />
    <bpmn:sequenceFlow id="P27" sourceRef="Task_Allocate" targetRef="Task_GuideAccept" />
    <bpmn:sequenceFlow id="P28" name="accept" sourceRef="Task_GuideAccept" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="P29" sourceRef="Boundary_GuideTimeout" targetRef="Task_ExcludeGuide" />
    <bpmn:sequenceFlow id="P30" sourceRef="Task_ExcludeGuide" targetRef="Task_FindGuide" />
    <bpmn:sequenceFlow id="P31" sourceRef="Task_Notify" targetRef="End_Allocated" />
    <bpmn:sequenceFlow id="P32" sourceRef="Boundary_NotifyError" targetRef="Task_ManualNotify" />
    <bpmn:sequenceFlow id="P33" sourceRef="Task_ManualNotify" targetRef="End_Allocated" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Student_Project_Approval">
    <bpmndi:BPMNPlane id="BPMNPlane_Student_Project_Approval" bpmnElement="Student_Project_Approval">
      <bpmndi:BPMNShape id="Start_Proposal_di" bpmnElement="Start_Proposal">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SubmitProposal_di" bpmnElement="Task_SubmitProposal">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
